    {
      "parameters": {
        "text": "=From: {{ $json.from.text }}\nSubject: {{ $json.subject }}\n\n{{ ($json.text || \"\").slice(0, 6000) }}",
        "schemaType": "fromJson",
        "jsonSchemaExample": "{\n  \"customer_name\": \"Jane Doe\",\n  \"product\": \"Mobile App\",\n  \"category\": \"billing\",\n  \"priority\": \"normal\",\n  \"summary\": \"Customer was charged twice for the March subscription and wants a refund.\"\n}",
        "options": {
          "systemPromptTemplate": "You are a customer support triage assistant. Read the incoming support email and extract the requested fields.\n- category: exactly one of billing, technical, account, sales, general. billing = payments, invoices, refunds; technical = bugs, errors, outages, how-to problems; account = login, password, access, profile changes; sales = pricing, demos, plans, purchase questions; general = anything else.\n- priority: exactly one of urgent, high, normal, low. urgent = complete service outage, security breach or suspected fraud, or a customer losing money right now with no workaround. high = billing errors such as double charges or refund requests, a customer blocked from using the product, or a clearly angry escalation. normal = standard request. low = feedback or non-time-sensitive question.\n- product: the product or service mentioned, or \"unspecified\".\n- customer_name: the sender's name if stated, else empty.\n- summary: one sentence describing the issue.\nUse lowercase for category and priority."
        }
      },
