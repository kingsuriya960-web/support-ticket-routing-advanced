    {
      "parameters": {
        "sendTo": "={{ $(\"Build Ticket\").item.json.assigned_to }}",
        "subject": "=[{{ $(\"Build Ticket\").item.json.priority.toUpperCase() }}] {{ $(\"Build Ticket\").item.json.ticket_id }} - {{ $(\"Build Ticket\").item.json.subject }}",
        "message": "=<p>A new support ticket has been assigned to <b>{{ $(\"Build Ticket\").item.json.assigned_team }}</b>.</p><ul><li><b>Ticket:</b> {{ $(\"Build Ticket\").item.json.ticket_id }}</li><li><b>Priority:</b> {{ $(\"Build Ticket\").item.json.priority }}</li><li><b>Category:</b> {{ $(\"Build Ticket\").item.json.category }}</li><li><b>Product:</b> {{ $(\"Build Ticket\").item.json.product }}</li><li><b>Customer:</b> {{ $(\"Build Ticket\").item.json.customer_name }} &lt;{{ $(\"Build Ticket\").item.json.customer_email }}&gt;</li><li><b>Summary:</b> {{ $(\"Build Ticket\").item.json.summary }}</li></ul><p><b>Original message:</b></p><blockquote>{{ $(\"Build Ticket\").item.json.email_body.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\").replace(/\\n/g, \"<br>\") }}</blockquote>",
        "options": {
          "appendAttribution": false,
          "replyTo": "={{ $(\"Build Ticket\").item.json.customer_email }}"
        }
      },
